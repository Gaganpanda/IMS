# Copy this file to .env and adjust values before running:
#   cp .env.example .env
#   docker compose up -d --build
#
# NEVER commit your real .env file — it is already ignored via .gitignore.

# ── Database ──
DB_NAME=ims_db
DB_USERNAME=root
DB_PASSWORD=change_me_to_a_strong_password

# ── Redis ──
REDIS_PASSWORD=

# ── JWT ──
# Generate a strong random 256-bit+ secret, e.g.: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_characters
JWT_EXPIRATION=86400000

# ── CORS (comma separated) ──
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# ── Frontend build-time API URL (relative path works since nginx proxies /api) ──
VITE_API_BASE_URL=/api

# ── Exposed host ports ──
MYSQL_EXPOSED_PORT=3307
REDIS_EXPOSED_PORT=6379
BACKEND_EXPOSED_PORT=8080
FRONTEND_EXPOSED_PORT=80
